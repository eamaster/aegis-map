/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aegis-map-backend",
	"main": "src/index.ts",
	/**
	 * Production compatibility date (restored). Test pool may pin a separate
	 * wrangler config if the local vitest workerd build lags this date.
	 */
	"compatibility_date": "2025-11-21",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"observability": {
		"enabled": true
	},
	/**
	 * Orbital-element refresh outside user requests (src/index.ts scheduled
	 * handler). Every 6 h, offset from the hour; CelesTrak asks clients not to
	 * re-download unchanged data more often than every 2 h.
	 */
	"triggers": {
		"crons": ["23 */6 * * *"]
	},
	/**
	 * KV Namespace for caching
	 */
	"kv_namespaces": [
		{
			"binding": "AEGIS_CACHE",
			"id": "7f6c89c7faa84c288f31941bef51b14c"
		}
	],
	/**
	 * Workers AI binding (native env.AI.run).
	 * remote: true is required for local wrangler dev to reach Workers AI.
	 * Usage counts against the account free Neurons allocation even in local dev.
	 */
	"ai": {
		"binding": "AI",
		"remote": true
	},
	/**
	 * Optional server-side model override (must be a supported Workers AI model ID).
	 * Prefer leaving unset to use the default in src/config.ts.
	 * Secrets: use .dev.vars for local FIRMS_MAP_KEY; wrangler secret put FIRMS_MAP_KEY for production.
	 * CORS_ORIGINS: comma-separated extra browser origins merged with defaults in src/config.ts.
	 */
	"vars": {
		"CORS_ORIGINS": "https://hesam.me,https://www.hesam.me"
	}
}
