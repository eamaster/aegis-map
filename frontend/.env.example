# Mapbox Access Token
# Get your token from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# Backend API Base URL (build-time; no trailing slash)
# Local: http://localhost:8787
# Production: GitHub Actions secret VITE_API_BASE_URL → Worker hostname
# Custom-domain frontends (e.g. https://hesam.me) must be listed in Worker CORS_ORIGINS
VITE_API_BASE_URL=http://localhost:8787
